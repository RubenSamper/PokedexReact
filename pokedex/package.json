{
  "name": "pokedex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "vite build && xcopy /E /Y /I dist\\* ..\\",
    "lint": "eslint .",
    "preview": "vite preview",
    "cap:init": "npx cap init com.pokedex.app Pokédex",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:build:android": "npx cap open android",
    "cap:build": "npx cap sync && npx cap copy",
    "build:capacitor": "set CAPACITOR_BUILD=true&&npm run build&&npx cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/status-bar": "^8.0.2",
    "@tanstack/react-query": "^5.101.0",
    "chart.js": "^4.5.1",
    "react": "^19.2.6",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "vite": "^8.0.12"
  }
}
